@model bool

@if (Model)
{
    <div id="sse" data-on-load="@@get('/Datastar/ConversationSSE', {filterSignals: {include: '/senderid/'}})">
        <button id="stop-play" data-on-click="@@get('/Datastar/StopConversation', {filterSignals: {exclude: '/.*/'}})" style="border: none; background: none;" title="Press to stop the live feed of messages">
            <img src="~/stop-button.svg" height="20" width="20" />
        </button>
    </div>
}
else
{
    <div id="sse" data-on-load="@@get('/Datastar/ConversationSSE', {filterSignals: {include: '/senderid/'}})">
        <button id="stop-play" data-on-click="@@get('/Datastar/PlayConversation', {filterSignals: {exclude: '/.*/'}})" style="border: none; background: none;" title="Press to play the live feed of messages">
            <img src="~/play-button.svg" height="20" width="20" />
        </button>
    </div>
}
